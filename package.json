{
  "name": "leaps",
  "version": "1.0.0",
  "private": true,
  "description": "Leaps — a Strides-style goal and habit tracker with a local SQLite database.",
  "author": "hollywoodj",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "icon": "python3 scripts/make-icon.py",
    "prepare:electron": "npm run build && node scripts/prepare-standalone.mjs",
    "electron:dev": "concurrently -k -s first \"npm run dev\" \"wait-on http://127.0.0.1:3000 && cross-env ELECTRON_START_URL=http://127.0.0.1:3000 electron .\"",
    "electron:start": "electron .",
    "electron:pack": "npm run prepare:electron && electron-builder --dir --publish never && npm rebuild better-sqlite3",
    "electron:build": "npm run prepare:electron && electron-builder --publish never && npm rebuild better-sqlite3",
    "electron:build:mac": "npm run prepare:electron && electron-builder --mac --publish never && npm rebuild better-sqlite3",
    "electron:build:win": "npm run prepare:electron && electron-builder --win --publish never && npm rebuild better-sqlite3",
    "electron:build:linux": "npm run prepare:electron && electron-builder --linux --publish never && npm rebuild better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.leaps.app",
    "productName": "Leaps",
    "copyright": "Copyright © 2026 Leaps",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Leaps ${version}",
      "backgroundColor": "#1b57b5"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Leaps"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "desktopName": "Leaps",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "hollywoodj",
      "repo": "leaps"
    }
  }
}
